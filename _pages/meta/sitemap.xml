---
layout: empty
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
  <!-- pages: lastmod is when the page or the data it shows last changed (_plugins/data_freshness.rb) -->
  {% for page in site.html_pages %}
  {% unless page.url == "/" or page.robots contains "noindex" %}
  <url>
    <loc>{{ site.url }}{{ page.url }}</loc>{% if page.sitemap_lastmod %}
    <lastmod>{{ page.sitemap_lastmod | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {% endunless %}
  {% endfor %}
     <!-- posts-->
  {% assign posts = site.posts %}
  {% for post in posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
     <!-- posts-->
  {% assign posts = site.newsletters %}
  {% for post in posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
     <!-- newsletters-->
</urlset>